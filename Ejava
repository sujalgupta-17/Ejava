    package com.example;
    import java.io.*;
    import java.nio.file.*;
    import javax.servlet.*;
    import javax.servlet.http.*;
    import javax.servlet.annotation.*;
    @WebServlet("/upload")
    @MultipartConfig(maxFileSize=5*1024*1024)
    public class UploadServlet extends HttpServlet {
      protected void doPost(HttpServletRequest req,HttpServletResponse res)
          throws ServletException,IOException {
        Part part=req.getPart("file");
        String name=Paths.get(part.getSubmittedFileName()).getFileName().toString();
        name=name.replaceAll("[^a-zA-Z0-9._-]","_");
        Path dir=Paths.get(System.getProperty("user.home"),"servlet-uploads");
        Files.createDirectories(dir);
        part.write(dir.resolve(name).toString());
        res.getWriter().println("Uploaded: "+name);
      }
    }

Create src/main/java/com/example/DownloadServlet.java:
    package com.example;
    import java.io.*;
    import java.nio.file.*;
    import javax.servlet.http.*;
    import javax.servlet.annotation.WebServlet;
    @WebServlet("/download")
    public class DownloadServlet extends HttpServlet {
      protected void doGet(HttpServletRequest req,HttpServletResponse res)
          throws IOException {
        String name=req.getParameter("name");
        if(name==null || !name.matches("[a-zA-Z0-9._-]+")) {
          res.sendError(400,"Invalid file name"); return;
        }
        Path f=Paths.get(System.getProperty("user.home"),"servlet-uploads",name);
        if(!Files.isRegularFile(f)) { res.sendError(404,"File not found"); return; }
        res.setContentType("application/octet-stream");
        res.setHeader("Content-Disposition","attachment; filename=\""+name+"\"");
        Files.copy(f,res.getOutputStream());
      }
    }
