Create src/main/webapp/update-employee.jsp:
    <%@ page import="java.sql.*,com.example.DB" %>
    <%@ page contentType="text/html;charset=UTF-8" %>
    <%
    try {
      int eno=Integer.parseInt(request.getParameter("eno"));
      int age=Integer.parseInt(request.getParameter("age"));
      double salary=Double.parseDouble(request.getParameter("salary"));
      String sql="UPDATE employee SET name=?,age=?,designation=?,salary=? WHERE eno=?";
      try(Connection con=DB.getConnection();
          PreparedStatement ps=con.prepareStatement(sql)) {
        ps.setString(1,request.getParameter("name"));
        ps.setInt(2,age);
        ps.setString(3,request.getParameter("designation"));
        ps.setDouble(4,salary);
        ps.setInt(5,eno);
        int rows=ps.executeUpdate();
        out.println(rows>0 ? "Employee updated" : "No matching employee number");
      }
    } catch(Exception e) { out.println("Invalid input/database error: "+e.getMessage()); }
    %>
    <br><a href="employees.jsp">View employees</a>

