Create src/main/java/com/example/CookieVisitServlet.java:
    package com.example;
    import java.io.*;
    import javax.servlet.http.*;
    import javax.servlet.annotation.WebServlet;
    @WebServlet("/visit-cookie")
    public class CookieVisitServlet extends HttpServlet {
      protected void doGet(HttpServletRequest req,HttpServletResponse res)
          throws IOException {
        int count=0;
        Cookie[] all=req.getCookies();
        if(all!=null) for(Cookie c:all) {
          if("visitCount".equals(c.getName())) {
            try { count=Integer.parseInt(c.getValue()); }
            catch(NumberFormatException ignored) { count=0; }
          }
        }
        count++;
        Cookie c=new Cookie("visitCount",String.valueOf(count));
        c.setMaxAge(30*24*60*60);
        c.setHttpOnly(true);
        res.addCookie(c);
        res.setContentType("text/html");
        res.getWriter().println("You visited this servlet "+count+" times.");
      }
    }

