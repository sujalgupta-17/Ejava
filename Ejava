Create src/main/java/com/example/NonBlockingServlet.java:
    package com.example;
    import java.io.*;
    import java.nio.charset.StandardCharsets;
    import javax.servlet.*;
    import javax.servlet.http.*;
    import javax.servlet.annotation.WebServlet;
    @WebServlet("/nonblocking")
    public class NonBlockingServlet extends HttpServlet {
      protected void doPost(HttpServletRequest req,HttpServletResponse res)
          throws IOException {
        res.setContentType("text/plain;charset=UTF-8");
        ServletInputStream in=req.getInputStream();
        in.setReadListener(new ReadListener() {
          ByteArrayOutputStream data=new ByteArrayOutputStream();
          public void onDataAvailable() throws IOException {
            byte[] b=new byte[1024];
            while(in.isReady() && !in.isFinished()) {
              int n=in.read(b);
              if(n>0) data.write(b,0,n);
            }
          }
          public void onAllDataRead() throws IOException {
            res.getWriter().write("Read complete: "+
              new String(data.toByteArray(),StandardCharsets.UTF_8));
          }
          public void onError(Throwable t) {
            getServletContext().log("Async read failed",t);
          }
        });
      }
    }
