Create src/main/java/com/example/CalculatorServlet.java:
    package com.example;
    import java.io.*;
    import javax.servlet.*;
    import javax.servlet.http.*;
    import javax.servlet.annotation.WebServlet;
    @WebServlet("/calculator")
    public class CalculatorServlet extends HttpServlet {
      protected void doPost(HttpServletRequest req,HttpServletResponse res)
          throws IOException {
        res.setContentType("text/html;charset=UTF-8");
        PrintWriter out=res.getWriter();
        try {
          double a=Double.parseDouble(req.getParameter("n1"));
          double b=Double.parseDouble(req.getParameter("n2"));
          String op=req.getParameter("op");
          double ans;
          switch(op) {
            case "add": ans=a+b; break;
            case "sub": ans=a-b; break;
            case "mul": ans=a*b; break;
            case "div":
              if(b==0) { out.println("Cannot divide by zero"); return; }
              ans=a/b; break;
            default: out.println("Invalid operation"); return;
          }
          out.println("<h2>Result: "+ans+"</h2>");
        } catch(NumberFormatException e) {
          out.println("Enter valid numbers");
        }
      }
    }
Test: /calculator.html

